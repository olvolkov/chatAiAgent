# RouterAPI Configuration (OpenAI Compatible)
ROUTERAPI_BASE_URL=https://routerai.ru/api/v1
ROUTERAPI_API_KEY=your_routerapi_api_key_here
MODEL_NAME=qwen/qwen3.6-flash # Model Name (optional, defaults to qwen/qwen3.6-flash)

# Tavily API Key
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_MAX_RESULTS=5

# Short Memory Limit (optional, defaults to 10)
# Maximum number of messages to keep in conversation history
MEMORY_LIMIT=10
